# ============================================================
# WavePilot 完整模式配置（API + 本地 MATLAB）
# 使用方法：复制本文件为 .env，填写下面 2 项，然后运行
#   Windows: start-full.bat
#   Linux/Mac: ./start-full.sh
# .env 已被 .gitignore 排除，不会提交到 GitHub。
# ============================================================

# 1) DashScope API Key（真实模型 + 真实 Embedding 必需）
#    留空或 not-configured 时：自主模式回退脚本化 Stub、知识库不可用
DASHSCOPE_API_KEY=not-configured

# 2) 本机 MATLAB 可执行文件路径
#    留空时使用 PATH 中的 matlab；例如 Windows:
#    MATLAB_EXECUTABLE=D:\Program Files\MATLAB\R2023b\bin\matlab.exe
MATLAB_EXECUTABLE=

# ---------- 以下均有默认值，通常无需修改 ----------

# 实验运行器：mock（默认，无需 MATLAB）/ local-matlab（真实仿真）
WAVEPILOT_RUNNER_TYPE=local-matlab

# 真实 MATLAB 执行的固定模板（脚本随项目打包，无需额外安装）
WAVEPILOT_MATLAB_TEMPLATE=polar-k-identification-simple-v1

# 知识库：milvus（默认，需 Docker 起 Milvus）/ memory（纯离线，无外网时用）
WAVEPILOT_KNOWLEDGE_REPOSITORY=milvus

# Embedding：false = 真实 DashScope（推荐）；true = 确定性离线向量（配 memory 用）
WAVEPILOT_EMBEDDING_OFFLINE=false

# 应用端口（默认 9900）
SERVER_PORT=9900

# 实验任务持久化：file = 落盘到 data/wavepilot/jobs（重启后历史任务仍在）
#                    in-memory = 仅内存（默认，适合测试/临时运行）
WAVEPILOT_JOBS_PERSISTENCE=file

# 可选 MySQL + RabbitMQ 后端（默认不启用；完整说明 docs/BACKEND_DISTRIBUTED_TASK.md）
# WAVEPILOT_JOB_REPOSITORY=mysql
# WAVEPILOT_NODE_ROLE=api
# WAVEPILOT_MYSQL_URL=jdbc:mysql://localhost:3306/wavepilot?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# WAVEPILOT_MYSQL_USER=wavepilot
# WAVEPILOT_MYSQL_PASSWORD=wavepilot-dev-only
# WAVEPILOT_RABBIT_HOST=localhost
# WAVEPILOT_RABBIT_PORT=5672
# WAVEPILOT_RABBIT_USER=wavepilot
# WAVEPILOT_RABBIT_PASSWORD=wavepilot-dev-only
# WAVEPILOT_SHARED_ARTIFACT_METADATA=true
# API 与 Worker 必须设置相同共享目录，默认演示 Runner 为 mock。

# 候选模板 Smoke 运行器：local-matlab = 用本机 MATLAB 真实执行候选模板 Smoke
#                    fake = 不执行（默认；配置了 local-matlab 实验运行器时自动跟随为 local-matlab）
WAVEPILOT_TEMPLATE_SMOKE_RUNNER=local-matlab

# 模板生成模型：llm = 真实 DashScope 按实验语义设计模板；stub = 固定演示模板（默认，测试/离线）
WAVEPILOT_TEMPLATE_GENERATION_MODE=llm

# 实验分析语言模型：llm = 真实 DashScope 做 grounded 分析（数值防幻觉校验）；
#                    默认不配置 = 仅确定性模板报告
WAVEPILOT_REPORT_LANGUAGE_MODE=llm

# 可选真实 listwise reranker；非法输出自动回退 deterministic
WAVEPILOT_MODEL_RERANKER_ENABLED=false
WAVEPILOT_RERANKER=deterministic

# Scientific Agent Planner / Replanner：deterministic（默认）/ model（需 API Key）
WAVEPILOT_SCIENTIFIC_PLANNER_MODE=deterministic
WAVEPILOT_SCIENTIFIC_REPLANNER_MODE=deterministic

# Scientific Agent 的 checkpoint、Execution Ledger 与 Artifact 持久化目录
WAVEPILOT_AGENT_RUN_STORE=data/wavepilot/agent-runs
WAVEPILOT_EXECUTION_LEDGER_STORE=data/wavepilot/execution-ledger
WAVEPILOT_ARTIFACT_ROOT=artifacts
